# Configurações do Supabase (Obrigatório para o funcionamento do sistema)
# Obtenha estas informações no painel do Supabase em Project Settings > API

VITE_SUPABASE_URL=seu_projeto_url_aqui
VITE_SUPABASE_ANON_KEY=seu_anon_key_aqui

# Nota: No Netlify, configure estas variáveis em:
# Site Settings > Build & deploy > Environment > Environment variables
